# Node Environment & Port Configuration
NODE_ENV=development
PORT=4008

# Service-to-Service Authentication Secret Header
# Required in X-Service-Auth HTTP request header
SERVICE_AUTH_TOKEN=your_loan_crm_service_auth_token_here

# Email Provider Configuration
EMAIL_PROVIDER=smtp

# SMTP Server Credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password

# Email Sender Defaults
EMAIL_FROM_ADDRESS=noreply@loancrm.example.com
EMAIL_FROM_NAME=Loan CRM Notifications
EMAIL_REPLY_TO=support@loancrm.example.com

# System Logging Level
LOG_LEVEL=info
